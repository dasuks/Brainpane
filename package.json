{
  "name": "brainpane",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "brainpane": "bin/brainpane.mjs"
  },
  "scripts": {
    "build": "node scripts/fix-pty-permissions.mjs && tsc --noEmit && tsc -p tsconfig.server.json",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "build:web-legacy": "vite build",
    "start": "node bin/brainpane.mjs run -- codex",
    "brainpane": "node bin/brainpane.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/terminal-e2e.mjs",
    "test:lifecycle": "node scripts/terminal-lifecycle-e2e.mjs",
    "setup": "node bin/brainpane.mjs setup",
    "test:web-legacy": "playwright test",
    "test:codex": "node scripts/verify-real-cli.mjs codex",
    "test:claude": "node scripts/verify-real-cli.mjs claude"
  },
  "dependencies": {
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "string-width": "^8.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
